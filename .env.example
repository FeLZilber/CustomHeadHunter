# Copy to .env for local use. Never commit real values.
# Docker Compose reads this file too, and supplies its own DATABASE_URL and OLLAMA_BASE_URL.

# --- Worker ---

# Required. For Neon use the pooled connection string with sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/headhunter

LOG_LEVEL=info
# true fetches and normalizes without writing.
DRY_RUN=false

# Freshness
FRESHNESS_GRACE_SNAPSHOTS=2
SUSPICIOUS_DROP_RATIO=0.5
SIGNIFICANT_CHANGE_FIELDS=title,locations,workArrangement,seniority,technologies,experience,salary

# Matching. The model and digest default to ollama/model-lock.json.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# OLLAMA_MODEL_DIGEST=
# MAX_MATCH_ATTEMPTS=3
# MATCH_RETRY_BASE_SECONDS=1800

# Run limits. Defaults live in src/config/budget.ts; see COSTS.md before raising them.
# MAX_HTTP_CONCURRENCY=4
# CRAWL_TIME_BUDGET_SECONDS=300
# MAX_AI_JOBS_PER_RUN=8
# AI_TIME_BUDGET_SECONDS=900
# AI_MINUTES_PER_MONTH=800
# INFERENCE_TIMEOUT_SECONDS=330
# MAX_JOB_INPUT_TOKENS=1600
# MAX_OUTPUT_TOKENS=1000
# OLLAMA_NUM_CTX=3200

# The alert threshold is a profile preference, 75 by default, edited on the dashboard.

# Telegram. Without both values discovery still runs and events stay pending.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# MAX_ALERTS_PER_RUN=10
# MAX_DIGESTS_PER_RUN=2
# DIGEST_SIZE=5
# MAX_NOTIFY_ATTEMPTS=5
# NOTIFY_RETRY_BASE_SECONDS=300
# NOTIFY_TIME_BUDGET_SECONDS=180

# Maintenance
# STALE_DISCOVERY_HOURS=14
# RETENTION_DAYS=90

# --- Dashboard ---
# Server-only: none of these reach the browser. DATABASE_URL above is shared.

# NEXTAUTH_URL=http://localhost:3000
# At least 32 characters: openssl rand -base64 32
# NEXTAUTH_SECRET=
# From a GitHub OAuth app whose callback is <NEXTAUTH_URL>/api/auth/callback/github
# GITHUB_ID=
# GITHUB_SECRET=
# The owner's numeric GitHub id, which unlike a username cannot be reassigned.
# OWNER_GITHUB_ID=
