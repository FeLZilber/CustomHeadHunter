# Copy to .env for local use. Never commit real values.

# Required. For Neon use the pooled connection string with sslmode=require.
DATABASE_URL=postgres://user:password@localhost:5432/headhunter

LOG_LEVEL=info
# true fetches and normalizes without writing.
DRY_RUN=false

# Freshness
FRESHNESS_GRACE_SNAPSHOTS=2
SUSPICIOUS_DROP_RATIO=0.5
SIGNIFICANT_CHANGE_FIELDS=title,locations,workArrangement,seniority,technologies,experience,salary

# Run limits. Defaults live in src/config/budget.ts; see COSTS.md before raising them.
# MAX_HTTP_CONCURRENCY=4
# CRAWL_TIME_BUDGET_SECONDS=300
